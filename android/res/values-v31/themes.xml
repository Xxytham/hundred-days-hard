<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch screen (Android 12+): the plate on the page color, held until the page has loaded -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_plate</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
